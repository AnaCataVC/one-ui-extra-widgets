<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_preview_vinyl_plinth"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp"
    tools:ignore="UseAppTint">

    <!-- Top Platter & Speed Readout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="@string/widget_music_vinyl_title"
            android:src="@drawable/ic_preview_vinyl_turntable" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@color/oneui_preview_vinyl_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="33⅓ RPM • QUARTZ LOCK"
                    android:textColor="@color/oneui_preview_vinyl_accent"
                    android:textSize="7.2sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0:00 / 0:00"
                android:textColor="@color/oneui_preview_vinyl_text_secondary"
                android:textSize="7.5sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Braun Minimalist Track Readout Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_preview_vinyl_readout"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/music_no_track"
            android:textColor="@color/oneui_preview_vinyl_text_primary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/music_tap_to_play"
            android:textColor="@color/oneui_preview_vinyl_text_secondary"
            android:textSize="8.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:background="@color/oneui_preview_vinyl_plinth_stroke">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="@color/oneui_preview_vinyl_accent" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 4 Circular Braun Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_preview_vinyl_btn"
            android:contentDescription="@string/widget_music_vinyl_title"
            android:padding="5dp"
            android:src="@drawable/ic_media_prev"
            android:tint="@color/oneui_preview_vinyl_text_primary" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_preview_vinyl_btn"
            android:contentDescription="@string/widget_music_vinyl_title"
            android:padding="6dp"
            android:src="@drawable/ic_media_play"
            android:tint="@color/oneui_preview_vinyl_text_primary" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_preview_vinyl_btn"
            android:contentDescription="@string/widget_music_vinyl_title"
            android:padding="5dp"
            android:src="@drawable/ic_media_next"
            android:tint="@color/oneui_preview_vinyl_text_primary" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_preview_vinyl_btn"
            android:contentDescription="@string/widget_music_vinyl_title"
            android:padding="5dp"
            android:src="@drawable/ic_media_menu"
            android:tint="@color/oneui_preview_vinyl_text_primary" />
    </LinearLayout>
</LinearLayout>

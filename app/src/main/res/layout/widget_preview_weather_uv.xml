<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_preview_oneui_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@string/widget_weather_uv_title"
        android:src="@drawable/ic_preview_weather_uv" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/weather_uv_moderate"
        android:textColor="@color/oneui_preview_uv_amber"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>

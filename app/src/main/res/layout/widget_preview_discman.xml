<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_music_discman_title"
            android:src="@drawable/ic_preview_discman_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPACT DISC"
                android:textColor="@color/oneui_preview_discman_title"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIGITAL AUDIO  •  ESP ANTI-SHOCK"
                android:textColor="@color/oneui_preview_discman_subtitle"
                android:textSize="5.5sp"
                android:textStyle="bold" />

            <!-- Cyan Backlit LCD Window -->
            <LinearLayout
                android:layout_width="112dp"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_preview_lcd_cyan"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="7dp"
                android:paddingRight="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CD • PAUSE"
                        android:textColor="@color/oneui_preview_lcd_text_secondary"
                        android:textSize="6.5sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="7dp"
                        android:contentDescription="@string/widget_music_discman_title"
                        android:src="@drawable/ic_discman_battery" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="▶ Pista 01"
                        android:textColor="@color/oneui_preview_lcd_text_primary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="@color/oneui_preview_lcd_text_primary"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/music_no_track"
                    android:textColor="@color/oneui_preview_lcd_text_secondary"
                    android:textSize="7sp" />
            </LinearLayout>

            <!-- 4-Button Ergonomic Control Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_preview_silver_circle"
                    android:contentDescription="@string/widget_music_discman_title"
                    android:padding="4dp"
                    android:src="@drawable/ic_media_prev" />

                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_preview_silver_circle"
                    android:contentDescription="@string/widget_music_discman_title"
                    android:padding="6dp"
                    android:src="@drawable/ic_media_play" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_preview_silver_circle"
                    android:contentDescription="@string/widget_music_discman_title"
                    android:padding="4dp"
                    android:src="@drawable/ic_media_next" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_preview_silver_circle"
                    android:contentDescription="@string/widget_music_discman_title"
                    android:padding="4dp"
                    android:src="@drawable/ic_media_menu" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

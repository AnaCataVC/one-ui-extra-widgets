<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_music_discman_title"
            android:src="@drawable/ic_preview_discman_body" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPACT DISC"
                android:textColor="@color/oneui_preview_discman_title"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESP ANTI-SHOCK"
                android:textColor="@color/oneui_preview_discman_subtitle"
                android:textSize="6sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Central Pill Module -->
        <LinearLayout
            android:layout_width="126dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_preview_discman_btn"
                android:gravity="center"
                android:text="⏮"
                android:textColor="@color/oneui_preview_discman_btn_text"
                android:textSize="9sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_preview_lcd_cyan"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="5dp"
                android:paddingRight="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CD • PLAY"
                    android:textColor="@color/oneui_preview_lcd_text_secondary"
                    android:textSize="6sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Retro Player"
                    android:textColor="@color/oneui_preview_lcd_text_primary"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_preview_discman_btn"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/oneui_preview_discman_btn_text"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_preview_discman_btn"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/oneui_preview_discman_btn_text"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

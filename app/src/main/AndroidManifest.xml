<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network & Open-Meteo API access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Location for Weather, AQI, and Wi-Fi SSID / Cellular Signal Cell Info -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 5G NR / LTE Signal Quality & Nearby Wi-Fi on Android 13+ -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:name=".OneUiWidgetsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneUiExtraWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OneUiExtraWidgets">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Active Media Session Listener for Retro Music Widgets (iPod, MP3, Discman) -->
        <service
            android:name=".data.media.MediaNotificationListener"
            android:exported="true"
            android:label="@string/media_listener_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 1. Weather Widget (Rain Probability, AQI, Moon Phase) -->
        <receiver
            android:name=".widgets.weather.OneUiWeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_weather_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <!-- 2. Astrology Widget (Sun/Moon Sign + Mercury & Planetary Retrogrades) -->
        <receiver
            android:name=".widgets.astrology.OneUiAstrologyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_astrology_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_astrology_info" />
        </receiver>

        <!-- 3. Retro Music Widget: iPod Classic -->
        <receiver
            android:name=".widgets.music.IpodClassicWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_music_ipod_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_ipod_info" />
        </receiver>

        <!-- 4. Retro Music Widget: 2000s MP3 LCD Stick -->
        <receiver
            android:name=".widgets.music.RetroMp3WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_music_mp3_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_mp3_info" />
        </receiver>

        <!-- 5. Retro Music Widget: Portable CD Discman -->
        <receiver
            android:name=".widgets.music.DiscmanWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_music_discman_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_discman_info" />
        </receiver>

        <!-- 6. 5G & Wi-Fi Network Quality Widget -->
        <receiver
            android:name=".widgets.network.OneUiNetworkWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_network_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_network_info" />
        </receiver>

        <!-- Persist AppCompat per-app locales on Android 8–12 (API < 33) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
